generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(OWNER)
  theme         String    @default("system")
  avatar        String?   @db.Text
  activeOrgId   String?
  phone          String?   // E.164 with country code, e.g. +5214423399798
  notifyEmail    Boolean   @default(true)
  notifyWhatsapp Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  organizations    Organization[] @relation("OrganizationOwner")
  memberships      Membership[]
  reports          AIReport[]
  chatMessages     AIChatMessage[]
  notifications    Notification[]
  apiKeys          ApiKey[]
  sentInvitations  Invitation[]  @relation("SentInvitations")
  activityLogs     ActivityLog[]
  alertRules       AlertRule[]
  pushSubscriptions PushSubscription[]
  tareasAsignadas     Tarea[]      @relation("TareaResponsable")
  receivablesVendidos Receivable[] @relation("ReceivableVendedor")
  paymentsRegistrados Payment[]    @relation("PaymentRegistradoPor")
  leads               Lead[]       @relation("LeadDueno")
  leadNotas           LeadNota[]   @relation("LeadNotaAutor")
  ventas              Venta[]      @relation("VentaVendedor")
  dailyReports        DailyReport[] @relation("DailyReportUser")
  rocas               Roca[]        @relation("RocaDueno")
  vendorTargets       VendorTarget[] @relation("VendorTargetUser")
  dashboardPreferences DashboardPreference[] @relation("DashboardPrefUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Organization ───────────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  industry    String?
  logo        String?  @db.Text
  brandColor  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation("OrganizationOwner", fields: [ownerId], references: [id])

  @@index([ownerId])

  memberships    Membership[]
  integrations   Integration[]
  metrics        Metric[]
  dashboards     Dashboard[]
  reports        AIReport[]
  chatMessages   AIChatMessage[]
  invitations    Invitation[]
  activityLogs   ActivityLog[]
  alertRules     AlertRule[]
  cashFlowAccounts    CashFlowAccount[]
  cashFlowCategories  CashFlowCategory[]
  receivables         Receivable[]
  clientes            Cliente[]
  tareas              Tarea[]
  leads               Lead[]
  ventas              Venta[]
  dailyReports        DailyReport[]
  rocas               Roca[]
  monthlyTargets      MonthlyTarget[]
  vendorTargets       VendorTarget[]
  dashboardPreferences DashboardPreference[]
  cashFlowSettings    CashFlowSettings?
}

model DashboardPreference {
  id        String   @id @default(cuid())
  bloques   Json     // ordered array of block ids (string[])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation("DashboardPrefUser", fields: [userId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Membership {
  id              String         @id @default(cuid())
  role            MembershipRole @default(VIEWER)
  allowedSections String[]       @default([])

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobRole        JobRole?

  @@unique([userId, organizationId])
}

// ─── Integrations ───────────────────────────────────────────────────

model Integration {
  id           String          @id @default(cuid())
  type         IntegrationType
  accessToken  String          @db.Text
  refreshToken String?         @db.Text
  expiresAt    DateTime?
  metadata     Json?
  isActive     Boolean         @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
}

// ─── Metrics ────────────────────────────────────────────────────────

model Metric {
  id        String         @id @default(cuid())
  category  MetricCategory
  name      String
  value     Float
  unit      String?
  period    DateTime
  source    IntegrationType?
  metadata  Json?
  createdAt DateTime       @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, category, period])
}

// ─── Dashboards ─────────────────────────────────────────────────────

model Dashboard {
  id        String   @id @default(cuid())
  name      String
  layout    Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ─── AI Reports ─────────────────────────────────────────────────────

model AIReport {
  id        String       @id @default(cuid())
  title     String
  content   String       @db.Text
  summary   String       @db.Text
  period    DateTime
  type      ReportType   @default(MONTHLY)
  status    ReportStatus @default(GENERATING)
  createdAt DateTime     @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedById  String
  generatedBy    User         @relation(fields: [generatedById], references: [id])
}

model AIChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}

// ─── Invitations ────────────────────────────────────────────────────

model Invitation {
  id              String         @id @default(cuid())
  email           String
  role            MembershipRole @default(VIEWER)
  allowedSections String[]       @default([])
  jobRole         JobRole?
  token           String         @unique @default(cuid())
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime       @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User         @relation("SentInvitations", fields: [invitedById], references: [id])

  @@unique([organizationId, email])
  @@index([token])
}

// ─── Enums ──────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipRole {
  ADMIN
  EDITOR
  VIEWER
}

enum JobRole {
  DIRECCION
  OPERACIONES
  COMERCIAL
  MARKETING
  ADMINISTRACION
}

enum ClienteEstatus {
  ACTIVO
  ESPERA
  VENCIDO
  BAJA
}

enum Salud {
  VERDE
  AMARILLO
  ROJO
}

enum ReceivableTipo {
  RECURRENTE
  UNICA
}

enum LeadOrigen {
  META
  ORGANICO
  OUTBOUND
  REFERIDO
  RED_DIRECTA
}

enum LeadEtapa {
  NUEVO
  CONTACTADO
  SESION_AGENDADA
  DIAGNOSTICO_VENDIDO
  PROPUESTA_ENVIADA
  CERRADO_GANADO
  CERRADO_PERDIDO
}

enum TareaEstatus {
  PENDIENTE
  COMPLETADA
}

enum IntegrationType {
  QUICKBOOKS
  HUBSPOT
  META_ADS
  SAT
  CUSTOM_API
  SPREADSHEET
}

enum MetricCategory {
  FINANCE
  SALES
  OPERATIONS
  HR
  MARKETING
}

enum ReportType {
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

enum ReportStatus {
  GENERATING
  COMPLETED
  FAILED
}

// ─── Notifications ──────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ─── Web Push subscriptions (one per browser/device) ────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Activity Log (team usage analytics + audit trail) ──────────────

model ActivityLog {
  id             String   @id @default(cuid())
  action         String   // "login" | "page.view" | "metric.create" | "report.generate" | ...
  detail         String?  @db.Text
  path           String?
  createdAt      DateTime @default(now())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

// ─── Alert Rules ────────────────────────────────────────────────────

model AlertRule {
  id             String   @id @default(cuid())
  metricName     String   // e.g. "Ventas del Mes"
  category       MetricCategory
  condition      String   // "below" | "above" | "change_pct_down" | "change_pct_up"
  threshold      Float    // e.g. 20 (percent) or 500000 (absolute)
  isActive       Boolean  @default(true)
  lastTriggered  DateTime?
  createdAt      DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}

// ─── API Keys ───────────────────────────────────────────────────────

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  lastUsed  DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
}

// ─── Cash Flow ──────────────────────────────────────────────────────

model CashFlowAccount {
  id             String   @id @default(cuid())
  name           String
  bankName       String?
  accountNumber  String?
  openingBalance Float    @default(0)
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   CashFlowTransaction[]

  @@index([organizationId, order])
}

model CashFlowTransaction {
  id              String   @id @default(cuid())
  date            DateTime
  bankReference   String?  @db.Text
  movementType    String?
  deposit         Float?
  withdrawal      Float?
  concept         String?
  provider        String?
  reference       String?
  invoiceUuid     String?
  taxRate         Float?
  salesType       String?
  incomeCategories  Json?
  expenseCategories Json?
  notes           String?  @db.Text
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accountId String
  account   CashFlowAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
}

model CashFlowSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  closedThroughMes String?   // latest CLOSED month "YYYY-MM"; that month and earlier are read-only
  updatedAt      DateTime @updatedAt
}

// ─── Cartera (clientes) ─────────────────────────────────────────────
model Cliente {
  id           String         @id @default(cuid())
  nombre       String
  contacto     String?
  montoMensual Float          @default(0)
  diaDePago    Int?           // 1..31
  estatus      ClienteEstatus @default(ACTIVO)
  salud        Salud          @default(VERDE)
  fechaAlta    DateTime       @default(now())
  notas        String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receivables    Receivable[]
  tareas         Tarea[]
  ventas         Venta[]

  @@index([organizationId])
}

// ─── Tareas (por cliente / mes) ─────────────────────────────────────
model Tarea {
  id              String       @id @default(cuid())
  descripcion     String
  mes             String       // "YYYY-MM"
  estatus         TareaEstatus @default(PENDIENTE)
  fechaCompletada DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  clienteId      String
  cliente        Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  responsableId  String?
  responsable    User?        @relation("TareaResponsable", fields: [responsableId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, mes])
}

// ─── Cobranza (cuentas por cobrar / facturación) ────────────────────
model Receivable {
  id            String    @id @default(cuid())
  invoiceFolio  String?
  concept       String?
  amount        Float     @default(0)
  issueDate     DateTime
  notes         String?   @db.Text
  order         Int       @default(0)
  pagado        Boolean   @default(false)
  fechaPago     DateTime?
  clienteManual String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Estatus se DERIVA de `pagado` y `issueDate` (nunca se almacena).
  clienteId  String?
  cliente    Cliente?        @relation(fields: [clienteId], references: [id])
  tipo       ReceivableTipo?
  vendedorId String?
  vendedor   User?           @relation("ReceivableVendedor", fields: [vendedorId], references: [id])
  payments   Payment[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, issueDate])
}

// ─── Abonos (pagos parciales sobre un receivable) ───────────────────
model Payment {
  id        String   @id @default(cuid())
  monto     Float
  fecha     DateTime @default(now())
  metodo    String?
  notas     String?  @db.Text
  createdAt DateTime @default(now())

  receivableId    String
  receivable      Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  registradoPorId String?
  registradoPor   User?      @relation("PaymentRegistradoPor", fields: [registradoPorId], references: [id])

  @@index([receivableId])
}

model CashFlowCategory {
  id             String   @id @default(cuid())
  code           String
  name           String
  type           String
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, order])
}

// ─── CRM (leads / pipeline) ─────────────────────────────────────────
model Lead {
  id                       String    @id @default(cuid())
  nombre                   String
  empresa                  String?
  contacto                 String?
  telefono                 String?
  email                    String?
  campana                  String?   // campaña de origen (ingesta Meta/Make)
  participantes            String?   // tamaño del equipo (formulario Meta)
  puesto                   String?   // puesto del contacto (formulario Meta)
  urgencia                 String?   // urgencia de compra (formulario Meta)
  origen                   LeadOrigen
  etapa                    LeadEtapa @default(NUEVO)
  valorEstimado            Float?
  valorMensualEstimado     Float?
  motivoPerdida            String?   @db.Text
  diagnosticoVentaGenerada Boolean   @default(false) // guards the one-time 9,997 venta
  fechaUltimoMovimiento    DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  duenoId        String
  dueno          User         @relation("LeadDueno", fields: [duenoId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notas          LeadNota[]
  ventas         Venta[]

  @@index([organizationId, etapa])
}

model LeadNota {
  id        String   @id @default(cuid())
  contenido String   @db.Text
  createdAt DateTime @default(now())

  leadId  String
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  autorId String?
  autor   User?   @relation("LeadNotaAutor", fields: [autorId], references: [id])

  @@index([leadId])
}

// ─── Ventas ─────────────────────────────────────────────────────────
model Venta {
  id                 String         @id @default(cuid())
  monto              Float
  tipo               ReceivableTipo
  concepto           String? // "Diagnóstico vendido" | "Cierre ganado" | manual note
  fechaCierre        DateTime       @default(now())
  fechaCobroEsperada DateTime?
  origen             LeadOrigen?
  createdAt          DateTime       @default(now())

  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clienteId      String?
  cliente        Cliente?     @relation(fields: [clienteId], references: [id])
  vendedorId     String?
  vendedor       User?        @relation("VentaVendedor", fields: [vendedorId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, fechaCierre])
}

// ─── Reportes diarios (por puesto) ──────────────────────────────────
model DailyReport {
  id        String   @id @default(cuid())
  fecha     String   // "YYYY-MM-DD" en America/Mexico_City (el día del reporte)
  jobRole   JobRole? // snapshot del puesto del autor al momento de enviar
  payload   Json     // campos específicos por puesto
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation("DailyReportUser", fields: [userId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, fecha])
  @@index([organizationId, fecha])
}

// ─── Rocas (objetivos trimestrales/mensuales por dueño) ─────────────
model Roca {
  id               String   @id @default(cuid())
  titulo           String
  metricaExito     String
  fechaLimite      DateTime
  estatus          Salud    @default(VERDE)
  porcentajeAvance Int      @default(0) // 0..100 (derived when usaChecklist)
  usaChecklist     Boolean  @default(false)
  mes              String   // "YYYY-MM"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  duenoId        String
  dueno          User         @relation("RocaDueno", fields: [duenoId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checklist      RocaChecklistItem[]

  @@index([organizationId, mes])
}

model RocaChecklistItem {
  id        String   @id @default(cuid())
  titulo    String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  rocaId String
  roca   Roca   @relation(fields: [rocaId], references: [id], onDelete: Cascade)

  @@index([rocaId])
}

// ─── Número Crítico mensual (meta de cobranza) ──────────────────────
model MonthlyTarget {
  id             String @id @default(cuid())
  mes            String
  meta           Float  @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, mes])
}

// ─── Meta de venta mensual por vendedor ─────────────────────────────
model VendorTarget {
  id             String @id @default(cuid())
  mes            String
  meta           Float  @default(0)

  userId         String
  user           User         @relation("VendorTargetUser", fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, mes, userId])
}
