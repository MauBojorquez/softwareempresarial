# ============================================================
#  Variables de entorno — StratiuMetrics
#  Copia este archivo a `.env` y llena cada valor.
#  Ninguno de estos valores debe subirse al repo.
# ============================================================

# ── Núcleo (obligatorias) ───────────────────────────────────
# Conexión a la base de datos PostgreSQL (Neon).
DATABASE_URL=
# URL pública del sitio, ej. https://app.tudominio.com
NEXTAUTH_URL=
# Cadena aleatoria para firmar las sesiones. Genera una con:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
# production | development
NODE_ENV=production

# ── Login con Google (OAuth) ────────────────────────────────
# Desde Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SAT ─────────────────────────────────────────────────────
# Llave para cifrar las credenciales del SAT guardadas en la BD.
# Genera una nueva con: openssl rand -base64 32
SAT_ENCRYPTION_KEY=

# ── Pagos (Stripe) ──────────────────────────────────────────
# Desde el dashboard de Stripe → Developers.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs de cada plan (Stripe → Products).
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=

# ── Integraciones ───────────────────────────────────────────
# Meta (Facebook / Instagram Ads).
META_APP_ID=
META_APP_SECRET=
# HubSpot.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# QuickBooks.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
# Make (webhooks entrantes).
MAKE_WEBHOOK_SECRET=

# ── Correo (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_API_KEY_2=
# Remitente de los correos, ej. no-reply@tudominio.com
EMAIL_FROM=

# ── Notificaciones push (VAPID) ─────────────────────────────
# Genera el par de llaves con: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Normalmente un mailto:, ej. mailto:soporte@tudominio.com
VAPID_SUBJECT=

# ── Otros ───────────────────────────────────────────────────
# Protege los endpoints de tareas programadas (cron).
CRON_SECRET=
