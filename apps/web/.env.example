# ============================================================
#  Variables de entorno — StratiuMetrics
#  Copia este archivo a `.env` y llena cada valor.
#  Ninguno de estos valores debe subirse al repo.
# ============================================================

# ── Núcleo (obligatorias) ───────────────────────────────────
# Conexión a la base de datos PostgreSQL (Neon).
DATABASE_URL=
# URL pública del sitio, ej. https://app.tudominio.com
NEXTAUTH_URL=
# Cadena aleatoria para firmar las sesiones. Genera una con:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
# production | development
NODE_ENV=production

# ── Login con Google (OAuth) ────────────────────────────────
# Desde Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Workspace (Gmail + Drive de cada colaborador) ───
# Cliente OAuth "Interno" con gmail.readonly y drive.readonly. Si se omite,
# se usa el cliente de login de arriba.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
# Llave para cifrar los permisos de Google guardados (40+ caracteres al azar).
# No cambiarla después: invalidaría las conexiones existentes.
GOOGLE_TOKEN_KEY=

# ── IA (Claude) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Opcional: modelo de las automatizaciones diarias (default claude-opus-5-5).
AI_DAILY_MODEL=

# ── Integraciones ───────────────────────────────────────────
# Meta (Facebook / Instagram Ads).
META_APP_ID=
META_APP_SECRET=
# Dueño por defecto de los leads que entran por la API.
META_LEAD_OWNER_EMAIL=
# Make (webhooks entrantes).
MAKE_WEBHOOK_SECRET=

# ── Correo (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_API_KEY_2=
# Remitente de los correos, ej. no-reply@tudominio.com
EMAIL_FROM=

# ── Notificaciones push (VAPID) ─────────────────────────────
# Genera el par de llaves con: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Normalmente un mailto:, ej. mailto:soporte@tudominio.com
VAPID_SUBJECT=

# ── Otros ───────────────────────────────────────────────────
# Protege los endpoints de tareas programadas (cron).
CRON_SECRET=
